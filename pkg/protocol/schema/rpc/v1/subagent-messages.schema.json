{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snow-core.dev/schemas/rpc/v1/subagent-messages.schema.json",
  "title": "Snow RPC bounded public subagent history page",
  "type": "object",
  "required": ["agent", "generation", "messages", "start", "total", "has_more"],
  "properties": {
    "agent": {"$ref": "common.schema.json#/$defs/agentRef"},
    "generation": {"type": "integer", "minimum": 0},
    "messages": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "message.schema.json"}
    },
    "next_cursor": {"type": "string", "minLength": 1, "maxLength": 4096},
    "start": {"type": "integer", "minimum": 0},
    "total": {"type": "integer", "minimum": 0},
    "has_more": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]},
      "then": {"required": ["next_cursor"]},
      "else": {"not": {"required": ["next_cursor"]}}
    }
  ],
  "additionalProperties": false
}
