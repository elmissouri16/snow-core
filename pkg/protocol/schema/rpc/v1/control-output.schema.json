      "description": "Acknowledges confirmed inactive-session deletion and managed cleanup. Uncertain or partial outcomes use an error response, never deleted:false success.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "type": {
          "const": "response"
        },
        "command": {
          "const": "session_delete"
