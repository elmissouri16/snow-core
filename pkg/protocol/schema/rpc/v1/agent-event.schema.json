{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snow-core.dev/schemas/rpc/v1/agent-event.schema.json",
  "title": "Snow normalized agent event",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "plugin_session_changed",
        "session_updated",
        "run_stats_updated",
        "text_delta",
        "thinking_delta",
        "tool_start",
        "tool_progress",
        "tool_end",
        "tool_routing",
        "permission_request",
        "user_input_request",
        "usage",
        "provider_retry",
        "queue_updated",
        "turn_done",
        "error",
        "aborted",
        "model_changed",
        "mode_changed",
        "plan_started",
        "plan_delta",
        "plan_completed",
        "plan_update",
        "compaction_started",
        "compaction_done",
        "thread_goal_updated",
        "subagent_started",
        "subagent_status",
        "subagent_message",
        "subagent_activity"
      ]
    },
    "text": {
      "type": "string"
    },
    "tool_call_id": {
      "type": "string"
    },
    "tool_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "tool_output": {
      "type": "string"
    },
    "tool_result": {
      "description": "Strict public tool-result text only; legacy tool_output may contain private display details. Text is bounded to 8192 UTF-8 bytes by the producer, not automatically scrubbed for task-output secrets.",
      "type": "object",
      "required": [
        "text",
        "truncated"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 8192
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "tool_duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "tool_progress": {
      "type": "object",
      "required": [
        "tool_call_id",
        "name",
        "done"
      ],
      "properties": {
        "tool_call_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "done": {
          "type": "boolean"
        },
        "is_error": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "tool_routing": {
      "type": "object",
      "required": [
        "trigger",
        "candidate_count",
        "selected_count",
        "exposed_count",
        "schema_bytes",
        "latency_ms"
      ],
      "properties": {
        "trigger": {
          "type": "string"
        },
        "tool_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "selected_count": {
          "type": "integer",
          "minimum": 0
        },
        "exposed_count": {
          "type": "integer",
          "minimum": 0
        },
        "schema_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "fallback": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "$ref": "common.schema.json#/$defs/usage"
    },
    "provider_retry": {
      "type": "object",
      "required": [
        "provider",
        "kind",
        "phase",
        "attempt",
        "max_attempts",
        "delay_ms",
        "elapsed_ms",
        "max_elapsed_ms"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "transient",
            "rate_limit"
          ]
        },
        "phase": {
          "enum": [
            "pre_activity",
            "recovery"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 2
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 2
        },
        "delay_ms": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_elapsed_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "model": {
      "$ref": "model.schema.json"
    },
    "mode": {
      "type": "object",
      "required": [
        "mode",
        "reasoning_effort"
      ],
      "properties": {
        "mode": {
          "enum": [
            "default",
            "plan"
          ]
        },
        "reasoning_effort": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "plan_update": {
      "type": "object",
      "required": [
        "plan"
      ],
      "properties": {
        "explanation": {
          "type": "string"
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "step",
              "status"
            ],
            "properties": {
              "step": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "pending",
                  "in_progress",
                  "completed"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "compaction": {
      "type": "object",
      "required": [
        "summarized_messages",
        "retained_messages"
      ],
      "properties": {
        "summarized_messages": {
          "type": "integer",
          "minimum": 0
        },
        "retained_messages": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        },
        "used_fallback": {
          "type": "boolean"
        },
        "automatic": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "permission": {
      "type": "object",
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "type": "object",
          "required": [
            "id",
            "tool",
            "args",
            "risk"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "args": {},
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "risk": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "user_input": {
      "$ref": "common.schema.json#/$defs/userInputRequest"
    },
    "queue": {
      "$ref": "common.schema.json#/$defs/inputQueue"
    },
    "thread_goal": {
      "type": "object",
      "properties": {
        "goal": {
          "$ref": "common.schema.json#/$defs/threadGoal"
        },
        "cleared": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "$ref": "common.schema.json#/$defs/agentRef"
    },
    "subagent": {
      "$ref": "common.schema.json#/$defs/subagentState"
    },
    "agent_message": {
      "type": "object",
      "required": [
        "id",
        "author",
        "recipient",
        "kind",
        "content",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "recipient": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "new_task",
            "message",
            "final_answer"
          ]
        },
        "content": {
          "type": "string"
        },
        "trigger_turn": {
          "type": "boolean"
        },
        "created_at": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "turn_id": {
      "type": "string"
    },
    "turn_origin": {
      "type": "string"
    },
    "turn_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "root_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "snapshot": {
      "type": "boolean"
    },
    "goal_continuing": {
      "type": "boolean"
    },
    "is_error": {
      "type": "boolean"
    },
    "plugin_view": {
      "$ref": "plugins.schema.json#/$defs/node"
    },
    "plugin_session_changed": {
      "type": "object",
      "required": [
        "old_session_id",
        "new_session_id",
        "old_branch_id",
        "new_branch_id",
        "reason",
        "generation"
      ],
      "properties": {
        "old_session_id": {
          "type": "string"
        },
        "new_session_id": {
          "type": "string"
        },
        "old_branch_id": {
          "type": "string"
        },
        "new_branch_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "queue_control": {
      "$ref": "queue-control.schema.json#/$defs/state"
    },
    "goal_run_id": {
      "type": "string",
      "description": "Correlates native events emitted by an explicitly owned goal run with its acceptance and goal_run_completed frame."
    }
  },
  "additionalProperties": false
}
