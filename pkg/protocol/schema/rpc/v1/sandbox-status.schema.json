{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snow-core.dev/schemas/rpc/v1/sandbox-status.schema.json",
  "title": "Snow RPC sandbox status",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": {
      "type": "object",
      "properties": {
        "configured": {"type": "boolean"},
        "active": {"type": "boolean"},
        "backend": {"type": "string"},
        "machine": {"type": "string"},
        "profile": {"type": "string"},
        "guest_cwd": {"type": "string"},
        "read_only": {"type": "boolean"},
        "network": {"type": "boolean"},
        "cpus": {"type": "integer"},
        "memory_mib": {"type": "integer"},
        "storage_gib": {"type": "integer"},
        "overlay_gib": {"type": "integer"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
